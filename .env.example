# Copy to ~/.config/easymc/llm.env (recommended) or export in shell.
# Never commit real keys.

# Optional OpenAI-compatible endpoint (e.g. api.tomail.gq, DeepSeek, local gateway)
EASYMC_LLM_BASE_URL=https://api.example.com/v1
EASYMC_LLM_API_KEY=sk-your-key-here
EASYMC_LLM_MODEL=deepseek-chat

# CurseForge (mod store)
# EASYMC_CURSEFORGE_API_KEY=
